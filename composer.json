{
  "name": "serger/typecaster",
  "description": "Simple typecasting with no external dependencies",
  "type": "library",
  "keywords": ["typecasting", "typecast"],
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "Serge Rodovnichenko",
      "email": "serge@syrnik.com"
    }
  ],
  "require": {
    "php": ">=7.2",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "vimeo/psalm": "^6.16"
  },
  "autoload": {
    "psr-4": {
      "SergeR\\Typecaster\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SergeR\\Typecaster\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "psalm:php72": "psalm --config=psalm.xml",
    "psalm:php85": "psalm --config=psalm-php85.xml"
  }
}
